<?xml version="1.0"?>
<robot name="six_arm"
    xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find mybot_description)/urdf/large_base.xacro" />
    <xacro:include filename="$(find mybot_description)/urdf/arm.xacro" />

    <!-- arm -->
    <xacro:property name="arm_offset_x" value="0.0" />
    <xacro:property name="arm_offset_y" value="0" />
    <xacro:property name="arm_offset_z" value="${base_height/2+0.01}" />

    <joint name="connect_joint" type="fixed">
        <origin xyz="${arm_offset_x} ${arm_offset_y} ${arm_offset_z}" rpy=" 0 0 0" />
        <parent link="base_link" />
        <child link="arm_base_link" />
    </joint>

    <!-- /////////////////////////////////   Gazebo   ////////////////////////////////////// -->
    <!-- /////////////////////////////////   机械臂   ////////////////////////////////////// -->
    <gazebo reference="arm_base_link">
        <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="link1">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="link2">
        <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="link3">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="link4">
        <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="link5">
        <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="link6">
        <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="gripper_finger_link1">
        <material>Gazebo/White</material>
    </gazebo>
    <gazebo reference="gripper_finger_link2">
        <material>Gazebo/White</material>
    </gazebo>
    
    <xacro:macro name="ros2_control_joint" params="joint_name">
        <joint name="${joint_name}">
            <command_interface name="position">
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface>
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
        </joint>
    </xacro:macro>

    <ros2_control name="GazeboSystem" type="system">
        <hardware>
            <plugin>gazebo_ros2_control/GazeboSystem</plugin>
        </hardware>
        <xacro:ros2_control_joint joint_name="joint1" />
        <xacro:ros2_control_joint joint_name="joint2" />
        <xacro:ros2_control_joint joint_name="joint3" />
        <xacro:ros2_control_joint joint_name="joint4" />
        <xacro:ros2_control_joint joint_name="joint5" />
        <xacro:ros2_control_joint joint_name="joint6" />
        <xacro:ros2_control_joint joint_name="finger_joint1" />
    </ros2_control>

    <gazebo>
        <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
            <parameters>$(find mybot)/config/ros2_controllers.yaml</parameters>
            <robot_param_node>robot_state_publisher</robot_param_node>
        </plugin>
    </gazebo>

    <!-- /////////////////////////////////   底盘   ////////////////////////////////////// -->
    <gazebo reference="base_footprint">
        <turnGravityOff>false</turnGravityOff>
    </gazebo>
    <gazebo reference="base_link">
        <material>Gazebo/Blue</material>
        <kp>1000000.0</kp>  <!-- 接触刚度（防止穿透） -->
        <kd>100.0</kd>    <!-- 接触阻尼（抑制弹飞） -->
        <minDepth>0.001</minDepth> <!-- 最小穿透深度 -->
    </gazebo>

    <gazebo reference="backl_caster_link">
        <material>Gazebo/Black</material>
        <mu1>0.01</mu1>  <!-- 静摩擦系数 -->
        <mu2>0.01</mu2>  <!-- 动摩擦系数 -->
        <kp>1000000.0</kp>  <!-- 接触刚度（防止穿透） -->
        <kd>100.0</kd>    <!-- 接触阻尼（抑制弹飞） -->
        <minDepth>0.001</minDepth> <!-- 最小穿透深度 -->
    </gazebo>

    <gazebo reference="backr_caster_link">
        <material>Gazebo/Black</material>
        <mu1>0.01</mu1>  <!-- 静摩擦系数 -->
        <mu2>0.01</mu2>  <!-- 动摩擦系数 -->
        <kp>1000000.0</kp>  <!-- 接触刚度（防止穿透） -->
        <kd>100.0</kd>    <!-- 接触阻尼（抑制弹飞） -->
        <minDepth>0.001</minDepth> <!-- 最小穿透深度 -->
    </gazebo>


    <xacro:macro name="wheel_transmission" params="prefix">
        <transmission name="${prefix}_wheel_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
            </joint>
            <actuator name="${prefix}_wheel_joint_motor">
                <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
                <mechanicalReduction>1</mechanicalReduction>
            </actuator>
        </transmission>

        <gazebo reference="${prefix}_wheel_link">
            <material>Gazebo/Gray</material>
            <mu1>1.0</mu1>  <!-- 驱动轮第一方向摩擦系数 -->
            <mu2>1.0</mu2>  <!-- 驱动轮第二方向摩擦系数 -->
            <kp>1000000.0</kp>  <!-- 接触刚度（防止穿透） -->
            <kd>100.0</kd>    <!-- 接触阻尼（抑制弹飞） -->
            <minDepth>0.001</minDepth> <!-- 最小穿透深度 -->
        </gazebo>
    </xacro:macro>
    
    <xacro:wheel_transmission prefix="left" />
    <xacro:wheel_transmission prefix="right" />

    <!-- Select one actuator only; default on the research branch is body force. -->
    <xacro:property name="drive_model" value="$(optenv AIC_DRIVE_MODEL body_force)" />
    <xacro:if value="${dict(wheel=True, body_force=False)[drive_model]}">
    <gazebo>
        <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
            <update_rate>30</update_rate>
            <!-- wheels -->
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>

            <!-- kinematics -->
            <wheel_separation>${wheel_joint_y*2}</wheel_separation>
            <wheel_diameter>${2*wheel_radius}</wheel_diameter>

            <!-- limits -->
            <max_wheel_torque>1000</max_wheel_torque>
            <!-- Nav2 velocity_smoother handles commanded acceleration and braking. -->
            <max_wheel_acceleration>0.0</max_wheel_acceleration>

            <!-- output -->
            <command_topic>cmd_vel</command_topic>
            <publish_odom>true</publish_odom>
            <publish_odom_tf>true</publish_odom_tf>
            <publish_wheel_tf>true</publish_wheel_tf>

            <odometry_topic>odom</odometry_topic>
            <odometry_frame>odom</odometry_frame>
            <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
    </gazebo>
    </xacro:if>
    <xacro:if value="${dict(wheel=False, body_force=True)[drive_model]}">
      <gazebo>
        <plugin name="body_force_controller" filename="libaic_body_drive.so">
          <body_link>base_footprint</body_link>
          <publish_rate>30</publish_rate>
          <command_timeout>0.5</command_timeout>
          <max_linear_speed>$(optenv AIC_BODY_MAX_LINEAR_SPEED 6.0)</max_linear_speed>
          <max_angular_speed>$(optenv AIC_BODY_MAX_ANGULAR_SPEED 4.0)</max_angular_speed>
          <max_lateral_acceleration>3.0</max_lateral_acceleration>
          <tilt_stop_radians>0.08726646259971647</tilt_stop_radians>
          <forward_kp>300</forward_kp><forward_ki>150</forward_ki><forward_limit>1000</forward_limit>
          <lateral_kp>1000</lateral_kp><lateral_ki>300</lateral_ki><lateral_limit>1000</lateral_limit>
          <yaw_kp>200</yaw_kp><yaw_ki>100</yaw_ki><yaw_limit>1000</yaw_limit>
          <odometry_frame>odom</odometry_frame>
          <robot_base_frame>base_footprint</robot_base_frame>
        </plugin>
      </gazebo>
    </xacro:if>
</robot>
