<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="laser">

    <xacro:macro name="lidar"
        params="prefix:=laser gz_visualize:=false range_min:=0.10 range_max:=30.0 topic:=scan show_visual:=true samples:=1441 update_rate:=10 min_angle:=-3.14159 max_angle:=3.14159">
        <!-- Create laser reference frame -->
        <link name="${prefix}_link">
            <inertial>
                <mass value="0.1" />
                <origin xyz="0 0 0" />
                <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01" />
            </inertial>

            <xacro:if value="${prefix == 'laser_left' or prefix == 'laser_right'}">
            <xacro:mecanum_visual link="${prefix}_link"/>
            <collision name="mecanum_scanner_housing"><geometry><cylinder radius="0.0355" length="0.034"/></geometry></collision>
            <collision name="mecanum_scanner_bracket"><origin xyz="-0.025 0 -0.025"/><geometry><box size="0.12 0.086 0.008"/></geometry></collision>
            </xacro:if>
            <xacro:if value="${show_visual}"><visual>
                <origin xyz=" 0 0 0 " rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.02" radius="0.031" />
                </geometry>
                <material name="black" />
            </visual></xacro:if>

            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0 0 0" />
                <geometry>
                    <cylinder length="0.01" radius="0.015" />
                </geometry>
            </collision>
        </link>
        <gazebo reference="${prefix}_link">
            <material>Gazebo/Black</material>
            <!-- 禁用自碰撞检测 -->
            <selfCollide>false</selfCollide>
            <disableCollisions>true</disableCollisions>
        </gazebo>

        <gazebo reference="${prefix}_link">
            <sensor type="ray" name="${prefix}_lidar">
                <update_rate>${update_rate}</update_rate>
                <visualize>${gz_visualize}</visualize>
                <ray>
                    <scan>
                        <horizontal>
                            <!-- Defaults use 0.25 degree rays. The round dual
                                 lidar model uses 0.333 degree rays (4.1 cm at 7 m). -->
                            <samples>${samples}</samples>
                            <!-- One returned range per ray: interpolation creates phantom edge hits. -->
                            <resolution>1</resolution>
                            <min_angle>${min_angle}</min_angle>
                            <max_angle>${max_angle}</max_angle>
                        </horizontal>
                    </scan>
                    <range>
                        <min>${range_min}</min>
                        <max>${range_max}</max>
                        <resolution>0.01</resolution>
                    </range>
                    <noise>
                        <type>gaussian</type>
                        <mean>0.0</mean>
                        <stddev>0.005</stddev>
                    </noise>
                </ray>
                <plugin name="${prefix}_gazebo_lidar" filename="libgazebo_ros_ray_sensor.so">
                    <ros>
                        <namespace>/</namespace>
                        <remapping>~/out:=${topic}</remapping>
                        <qos><topic name="${topic}"><publisher>
                            <reliability>best_effort</reliability>
                            <history depth="5">keep_last</history>
                        </publisher></topic></qos>
                    </ros>
                    <output_type>sensor_msgs/LaserScan</output_type>
                    <frame_name>${prefix}_link</frame_name>
                </plugin>
            </sensor>
        </gazebo>

    </xacro:macro>
</robot>
