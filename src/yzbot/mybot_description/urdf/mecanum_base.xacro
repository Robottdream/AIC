<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="six_arm">
  <xacro:include filename="$(find mybot_description)/urdf/mecanum_visuals.xacro"/>
  <xacro:property name="M_PI" value="3.141592653589793"/>
  <xacro:property name="base_height" value="0.1"/>
  <xacro:property name="base_length" value="0.48"/>
  <xacro:property name="base_width" value="0.40"/>
  <xacro:macro name="mecanum_box_inertia" params="m x y z">
    <inertial><mass value="${m}"/><inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0" iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/></inertial>
  </xacro:macro>
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.11"/></joint>
  <link name="base_link">
    <xacro:mecanum_visual link="base_link"/>
    <collision><geometry><cylinder radius="0.24" length="0.10"/></geometry></collision>
    <collision name="upper_deck"><origin xyz="0 0 0.054"/><geometry><cylinder radius="0.225" length="0.008"/></geometry></collision>
    <collision name="arm_mount"><origin xyz="0 0 0.064"/><geometry><box size="0.13 0.13 0.012"/></geometry></collision>
    <collision name="yaw_motor"><origin xyz="0 0 0.097"/><geometry><cylinder radius="0.06" length="0.054"/></geometry></collision>
    <collision name="yaw_bearing"><origin xyz="0 0 0.131"/><geometry><cylinder radius="0.073" length="0.014"/></geometry></collision>
    <inertial><mass value="6"/><inertia ixx="0.0914" iyy="0.0914" izz="0.1728" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <xacro:macro name="mecanum_wheel" params="prefix x y theta">
    <joint name="${prefix}_wheel_joint" type="continuous"><parent link="base_link"/><child link="${prefix}_wheel_link"/><origin xyz="${x} ${y} -0.035" rpy="0 0 ${theta-(1 if y>0 else -1)*M_PI/2}"/><axis xyz="0 ${1 if y>0 else -1} 0"/><dynamics damping="0.01"/></joint>
    <link name="${prefix}_wheel_link">
      <xacro:mecanum_visual link="${prefix}_wheel_link"/>
      <!-- Simplified support cylinder: planar drive is an ideal kinematic model,
           not a simulation of roller traction or motor torque. -->
      <collision><origin rpy="${M_PI/2} 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
      <inertial><mass value="0.7"/><inertia ixx="0.001194" ixy="0" ixz="0" iyy="0.001969" iyz="0" izz="0.001194"/></inertial>
    </link>
    <gazebo reference="${prefix}_wheel_link"><mu1>0.01</mu1><mu2>0.01</mu2><kp>1000000</kp><kd>100</kd><minDepth>0.001</minDepth></gazebo>
  </xacro:macro>
  <xacro:mecanum_wheel prefix="front_left" x="0.195" y="0.195" theta="0.7853981633974483"/>
  <xacro:mecanum_wheel prefix="front_right" x="0.195" y="-0.195" theta="-0.7853981633974483"/>
  <xacro:mecanum_wheel prefix="rear_left" x="-0.195" y="0.195" theta="2.356194490192345"/>
  <xacro:mecanum_wheel prefix="rear_right" x="-0.195" y="-0.195" theta="-2.356194490192345"/>
  <joint name="arm_yaw_joint" type="revolute"><parent link="base_link"/><child link="arm_yaw_link"/><origin xyz="0 0 0.15"/><axis xyz="0 0 1"/><limit lower="${-M_PI}" upper="${M_PI}" effort="20" velocity="1.5"/><dynamics damping="0.1"/></joint>
  <link name="arm_yaw_link"><xacro:mecanum_visual link="arm_yaw_link"/><collision><origin xyz="0 0 -0.006"/><geometry><cylinder radius="0.065" length="0.012"/></geometry></collision><inertial><mass value="0.4"/><inertia ixx="0.00043" ixy="0" ixz="0" iyy="0.00043" iyz="0" izz="0.000845"/></inertial></link>
</robot>
